DEEPSEEK_API_KEY=replace-with-chat-api-key
DEEPSEEK_BASE_URL=https://example.com/v1
DEEPSEEK_MODEL=replace-with-chat-model

DATABASE_URL=postgresql+psycopg://user:password@host:5432/littrace

EMBEDDING_API_KEY=replace-with-embedding-api-key
EMBEDDING_BASE_URL=https://example.com/compatible-mode/v1
EMBEDDING_MODEL=replace-with-embedding-model

# 单位：美元 / 一百万 token。请按实际供应商与模型价格填写。
# 留为 0 时仍会记录 token 和调用耗时，但估算成本保持 $0。
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
